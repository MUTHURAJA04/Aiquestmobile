import React, { useState } from "react";
import { View, Text, TouchableOpacity, Alert } from "react-native";
import { submitQuiz } from "../../services/apiClient";

const SubmitQuiz = ({ quizId, userAnswers }) => {
  const [loading, setLoading] = useState(false);

  const handleSubmitQuiz = async () => {
    try {
      setLoading(true);
      const res = await submitQuiz(quizId, userAnswers);
   

      if (res.status === 1) {
        Alert.alert("Success", "Your quiz was submitted successfully!");
      } else {
        Alert.alert("Oops!", "Quiz submission failed! Retry");
      }
    } catch (error) {
     
      Alert.alert("Oops!", "Failed to submit quiz, Retry ");
    } finally {
      setLoading(false);
    }
  };

  return (
    <View>
      <TouchableOpacity
        onPress={handleSubmitQuiz}
        disabled={loading}
        className={`bg-blue-600 p-4 rounded-2xl ${loading ? "opacity-50" : ""}`}
      >
        <Text className="text-white font-bold text-center">
          {loading ? "Submitting..." : "Submit Quiz"}
        </Text>
      </TouchableOpacity>
    </View>
  );
};

export default SubmitQuiz;
